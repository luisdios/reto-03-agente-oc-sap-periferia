# Configura este valor en Replit Secrets o expórtalo en tu terminal local.
# Nunca guardes una clave real en este archivo ni en el frontend.
GEMINI_API_KEY=

# Modelo oficial Gemini con soporte de function calling.
GEMINI_MODEL=gemini-3.6-flash

# Límites de uso del agente.
AGENT_MAX_ITERATIONS=25
AGENT_MAX_SESSION_TOKENS=40000
AGENT_MAX_PROCESS_TOKENS_PER_DAY=200000

# Puertos del comando pnpm dev.
API_SERVER_PORT=8080
WEB_PORT=22663
